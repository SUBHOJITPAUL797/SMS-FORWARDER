<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Card Container -->
    <LinearLayout
        android:id="@+id/floating_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_floating_card"
        android:elevation="12dp">

        <!-- Top Header Banner (Emerald Green) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_floating_header"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_notification"
                android:tint="#FFFFFF"
                android:contentDescription="SMS Bridge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="SMS Bridge"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_floating_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="SMS · Just now"
                android:textColor="#D1FAE5"
                android:textSize="11.5sp" />

            <!-- Close Button "✕" -->
            <ImageView
                android:id="@+id/btn_floating_close"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:padding="5dp"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Card Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- Sender Row with Avatar & Verified Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Avatar Circle with Initial -->
                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_floating_avatar">

                    <TextView
                        android:id="@+id/tv_floating_initial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="S"
                        android:textColor="@color/floating_btn_text"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Sender Info & Verified Badge -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_floating_sender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Centru Bank"
                            android:textColor="@color/floating_otp_digits"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <!-- Verified Checkmark Badge -->
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="5dp"
                            android:src="@drawable/ic_check"
                            android:tint="#10B981"
                            android:contentDescription="Verified" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="FORWARDED SMS"
                        android:textColor="#10B981"
                        android:textSize="10.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />
                </LinearLayout>

            </LinearLayout>

            <!-- Large Spaced OTP Digits -->
            <TextView
                android:id="@+id/tv_floating_otp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="881 231"
                android:textColor="@color/floating_otp_digits"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:maxLines="1" />

            <!-- Subtitle Notice -->
            <TextView
                android:id="@+id/tv_floating_subtext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="14dp"
                android:gravity="center"
                android:text="Don't share your OTP with anyone"
                android:textColor="@color/floating_subtext"
                android:textSize="12sp"
                android:maxLines="1" />

            <!-- Full-width COPY OTP Action Button -->
            <LinearLayout
                android:id="@+id/btn_floating_copy"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_floating_copy_btn"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_copy"
                    android:tint="@color/floating_btn_text"
                    android:contentDescription="Copy" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="COPY OTP"
                    android:textColor="@color/floating_btn_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
