<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Header / Sender line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OTP from 59029411"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="now"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <!-- Prominent OTP Row with Copy Button Beside It -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/notif_otp_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="5  2  9  7  5  7"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:letterSpacing="0.1"
            android:maxLines="1" />

        <!-- Quick Copy Action beside OTP -->
        <LinearLayout
            android:id="@+id/btn_copy_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_copy_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_copy"
                android:contentDescription="Copy OTP" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Copy"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2563EB" />
        </LinearLayout>
    </LinearLayout>

    <!-- Boxy Full Message Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_notification_box"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/notif_full_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full message content will display here completely so the user does not need to open the app."
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:textColor="?android:attr/textColorPrimary"
            android:maxLines="25"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Bottom Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|start"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/btn_action_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mark as read"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:paddingStart="6dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_action_dismiss"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dismiss"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#2563EB"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_action_copy_sms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copy SMS"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#6B7280"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
