<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Header / Sender line -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📩 Message from Sender"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/notif_text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notif_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="now"
            android:textSize="11sp"
            android:textColor="@color/notif_text_secondary" />
    </LinearLayout>

    <!-- Boxy Full Message Container with High Contrast in Light & Dark Mode -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_notification_box"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="2dp">

        <TextView
            android:id="@+id/notif_full_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full message content will display here completely so the user does not need to open the app."
            android:textSize="13.5sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/notif_text_primary"
            android:maxLines="30"
            android:ellipsize="end" />
    </LinearLayout>

</LinearLayout>
